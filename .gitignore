# env
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*

node_modules
*.local

# build output (dist/client is what gets uploaded to Bluehost)
dist
.tanstack

# generated by the TanStack Router plugin on every dev/build run — never edit
src/routeTree.gen.ts

# local dev database
.data

# real API config holds database credentials; only config.example.php is committed
public/api/config.php
tsw-config.php

# runtime uploads (the folder's .htaccess rules are kept)
public/uploads/*
!public/uploads/.htaccess

# editor / local tooling
.claude
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.sw?
