# Uploaded images only: no scripts, no directory listing, and SVGs cannot run JavaScript.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py
<FilesMatch "\.(php|phtml|phar|cgi|pl|py)[0-9]*$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
  Header set X-Content-Type-Options "nosniff"
</IfModule>
